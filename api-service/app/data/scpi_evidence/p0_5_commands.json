{
  "schema_version": 1,
  "commands": [
    {
      "id": "f64.model_load", "instrument": "f64", "mandatory": true,
      "command": "CALCulate:FILTer:FILE <path>", "query": "DIAGnostic:SIMUlation:MODel:STATE?",
      "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.3 / 20.6.1.1"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]},
      "notes": "加载后须 OPC、错误队列、模型/仿真状态共同确认。"
    },
    {
      "id": "f64.operation_complete", "instrument": "f64", "mandatory": true,
      "command": "*OPC?", "query": "*OPC?", "status": "confirmed", "max_evidence_level": "E1",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim ATE environment and practices AN", "section": "1.3 / User Reference 20.6.1.2"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]},
      "notes": "只证明操作完成，不证明无错误或已生效。"
    },
    {
      "id": "f64.error_queue", "instrument": "f64", "mandatory": true,
      "command": "SYSTem:ERRor?", "query": "SYSTem:ERRor?", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.1 / 20.6.1.1"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "必须在本次事务前清旧队列并在写后读取。"
    },
    {
      "id": "f64.simulation_state", "instrument": "f64", "mandatory": true,
      "command": "DIAGnostic:SIMUlation:GO", "query": "DIAGnostic:SIMUlation:STATE?", "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.3.14"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "RUNNING 是仿真实际运行判据。"
    },
    {
      "id": "f64.model_state", "instrument": "f64", "mandatory": true,
      "command": "DIAGnostic:SIMUlation:MODel:STATE?", "query": "DIAGnostic:SIMUlation:MODel:STATE?", "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.3"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "用于核对当前模型/CIR/仿真时间。"
    },
    {
      "id": "f64.center_frequency", "instrument": "f64", "mandatory": true,
      "command": "CALCulate:FILTer:CENTer:CHannel <channel>,<MHz>", "query": "CALCulate:FILTer:CENTer:CHannel? <channel>", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.6.1-2"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "中心频率按仿真组生效；回读只证明参数值。"
    },
    {
      "id": "f64.input_reference", "instrument": "f64", "mandatory": true,
      "command": "INPut:LEVel:AMPLitude:CHannel <input>,<dBm>", "query": "INPut:LEVel:AMPLitude:CHannel? <input>", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.4.3-5"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "空回复不得解释为已接受。"
    },
    {
      "id": "f64.crest_factor", "instrument": "f64", "mandatory": true,
      "command": "INPut:CRESt:SET <input>,<dB>", "query": "INPut:CRESt:GET? <input>", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.4.9-11"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "写后回读并结合输入测量/系统状态判定。"
    },
    {
      "id": "f64.output_gain", "instrument": "f64", "mandatory": true,
      "command": "OUTPut:GAIN:CHannel <output>,<dB>", "query": "OUTPut:GAIN:CHannel? <output>", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.5.7-8"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "超范围可能静默钳位，必须回读。"
    },
    {
      "id": "f64.output_loss", "instrument": "f64", "mandatory": true,
      "command": "OUTPut:LOSS:SET <output>,<dB>", "query": "OUTPut:LOSS:GET? <output>", "status": "confirmed", "max_evidence_level": "E2",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.5.19-20"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "逐输出口回读。"
    },
    {
      "id": "f64.bypass_mode", "instrument": "f64", "mandatory": true,
      "command": "DIAGnostic:SIMUlation:MODel:STATic <mode>", "query": "DIAGnostic:SIMUlation:MODel:STATic?", "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.6.25-26"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "旁路/衰落状态需精确回读。"
    },
    {
      "id": "f64.topology_model_info", "instrument": "f64", "mandatory": true,
      "command": "DIAGnostic:SIMUlation:MODel:INFO?", "query": "DIAGnostic:SIMUlation:MODel:INFO?", "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.3.6"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "返回当前已加载仿真的输入、逻辑通道与输出数量；必须与逐组端口回读交叉核对。"
    },
    {
      "id": "f64.topology_group_count", "instrument": "f64", "mandatory": true,
      "command": "GROup:GET?", "query": "GROup:GET?", "status": "confirmed", "max_evidence_level": "E3",
      "source": {"kind": "notebooklm", "source_id": "982222b7-4953-46cd-9949-00fa97882353", "document": "Propsim User Reference", "section": "20.4.7.1"},
      "applicability": {"models": ["PROPSIM F64", "F8800*"], "firmware_versions": ["*"]}, "notes": "返回当前仿真的通道组数量。"
    },
    {
      "id": "f64.topology_group_channels", "instrument": "f64", "mandatory": true,
      "command": "GROup:CHANnels:GET? <group>", "query": "GROup:CHANnels:GET? <group>", "status": "confirmed", "max_evidence_level": "E3",
