WITH C AS (SELECT CLUSTER_CDL(CHANNEL_TYPE, DELAY, H, AOA, ZOA, AOD, ZOD, DOPPLER:DOPPLER), LINK_ID FROM CHANNEL GROUP BY LINK_ID) SELECT WRITE_CSV("R0B0S0U_cluster_cdl.csv", LINK_ID:LINK_ID, CHANNEL_TYPE:CHANNEL_TYPE, DELAY:DELAY, PL:H2PL(H), PHASE_DEG:H2ANG(H), AOA:AOA, ZOA:ZOA, AOD:AOD, ZOD:ZOD, DOPPLER:DOPPLER) FROM C;
